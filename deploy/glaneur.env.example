# Configuration de Glaneur (lue par le service systemd).
# Après modification : systemctl restart glaneur

# Port et adresse d'écoute
PORT=8080
HOST=0.0.0.0

# Dossier des données (base SQLite)
DATA_DIR=/var/lib/glaneur

# Fuseau horaire utilisé pour les dates affichées sans fuseau sur les sites
TZ=Europe/Paris

# Mot de passe imposé au démarrage. Sans cette ligne, il est choisi au premier accès.
#GLANEUR_PASSWORD=

# Désactive l'authentification : uniquement derrière un proxy qui authentifie déjà.
#GLANEUR_AUTH=none

# Adresse publique utilisée dans les liens des flux (utile derrière un proxy inverse)
#PUBLIC_URL=https://glaneur.maison.lan

# Faire confiance aux en-têtes X-Forwarded-* envoyés par un proxy inverse
#TRUST_PROXY=true

# Chemin de Chromium pour le rendu JavaScript (détecté automatiquement sinon)
#CHROMIUM_PATH=/usr/bin/chromium

# Nombre de flux actualisés en parallèle, et de rendus Chromium simultanés
#MAX_CONCURRENCY=3
#BROWSER_CONCURRENCY=1
