{
  "name": "glaneur",
  "version": "1.0.0",
  "private": true,
  "description": "Glaneur — créez des flux RSS sur mesure pour les sites qui n'en proposent pas.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "node dist/node/server/index.js",
    "test": "vitest run",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "^16.40.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "chrono-node": "^2.10.1",
    "diff": "^9.0.0",
    "domhandler": "^5.0.3",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.4",
    "linkedom": "^0.18.13",
    "puppeteer-core": "^25.11.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@fontsource-variable/recursive": "^5.3.0",
    "@tanstack/react-query": "^5.102.8",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1",
    "simple-icons": "^16.31.0",
    "sonner": "^2.0.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
